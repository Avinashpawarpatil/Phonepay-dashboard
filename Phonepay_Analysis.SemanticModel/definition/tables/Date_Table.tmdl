		sourceColumn: [Weekend]

		annotation SummarizationSetBy = Automatic

	partition Date_Table = calculated
		mode: import
		source =
				ADDCOLUMNS(CALENDAR(MIN(All_Transactions[Date]),MAX(All_Transactions[Date])),
				"Year",YEAR([Date]),
				"Month No.",MONTH([Date]),
				"Month",FORMAT([Date],"MMM"),
				"Quater","Q"&FORMAT([Date],"Q"),
				"Weekday",FORMAT([Date],"dddd"),
				"Day No.", WEEKDAY([Date],2),
				"Weekend",
				IF(WEEKDAY([Date],2)>=6,"Weekend","Weekday")
				)

	annotation PBI_Id = c6216016ae2d4c0b85b4d0fc78090043

